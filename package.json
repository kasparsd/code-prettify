{
  "name": "@kasparsd/code-prettify",
  "private": true,
  "description": "WordPress plugin for automatic code highlighting using the Prettify library.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kasparsd/code-prettify.git"
  },
  "keywords": [
    "wordpress"
  ],
  "author": "Kaspars Dambis",
  "license": "GPL-2.0",
  "bugs": {
    "url": "https://github.com/kasparsd/code-prettify/issues"
  },
  "homepage": "https://github.com/kasparsd/code-prettify#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "zip": "wp-release zip --slug code-prettify --force",
    "lint": "npm run lint:php",
    "lint:php": "composer lint",
    "postinstall": "composer install",
    "env": "wp-env",
    "release": "wp-release"
  },
  "devDependencies": {
    "@wordpress/env": "^11.17.0",
    "@wordpress/scripts": "^36.1.0",
    "@wpelevator/wp-release": "^0.16.0"
  }
}
